{
  "name": "vela-telegram-dating", "version": "0.1.0", "private": true,
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:web": "tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
    "lint": "eslint apps packages tests scripts",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "start": "node dist/api/apps/api/src/main.js",
    "start:render": "node scripts/render-start.cjs",
    "worker": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/worker.ts",
    "bot:setup": "tsx scripts/bot-setup.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0", "@nestjs/core": "^11.1.0", "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0", "@prisma/client": "6.19.3", "@supabase/supabase-js": "^2.57.0",
    "@tanstack/react-query": "^5.90.0", "cookie-parser": "^1.4.7", "dotenv": "^16.6.0",
    "express": "^5.1.0", "helmet": "^8.1.0", "i18next": "^25.5.0", "ioredis": "^5.8.0",
    "lucide-react": "^0.468.0", "react": "^19.1.0", "react-dom": "^19.1.0", "react-i18next": "^15.7.0",
    "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2", "sharp": "^0.34.0", "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1", "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0", "@types/cookie-parser": "^1.4.9", "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0", "@types/node": "^22.18.0", "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0", "concurrently": "^9.2.0", "eslint": "^9.35.0", "prisma": "6.19.3",
    "tsx": "^4.20.0", "typescript": "^5.9.0", "typescript-eslint": "^8.42.0", "vite": "^6.3.0",
    "@electric-sql/pglite": "^0.3.10", "@prisma/adapter-pg": "6.19.3", "pg": "^8.16.0", "@types/pg": "^8.15.0"
  },
  "prisma": {"seed": "tsx prisma/seed.ts"}
}
